      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(readaloud_tts_synthesis_seconds_bucket{namespace=\"$namespace\"}[5m])))",
