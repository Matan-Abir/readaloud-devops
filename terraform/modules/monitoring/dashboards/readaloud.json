          "expr": "histogram_quantile(0.95, sum by (le, kind) (rate(readaloud_llm_latency_seconds_bucket{namespace=\"$namespace\"}[5m])))",
          "legendFormat": "{{kind}} p95 s"
        }
      ],
      "fieldConfig": {
        "defaults": {
