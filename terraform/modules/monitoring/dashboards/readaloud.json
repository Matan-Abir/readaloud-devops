      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(readaloud_users_registered_total{namespace=\"$namespace\"}[1h]))",
          "legendFormat": "users registered"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(readaloud_documents_uploaded_total{namespace=\"$namespace\"}[1h]))",
          "legendFormat": "documents uploaded"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(readaloud_tts_chunks_served_total{namespace=\"$namespace\"}[1h]))",
