# Copy to .env next to docker-compose.yml (never commit .env)
JENKINS_ADMIN_PASSWORD=admin
SONAR_ADMIN_PASSWORD=ReadAloud-Sonar-2026!
# Branch of readaloud-devops that holds the Jenkinsfile
DEVOPS_BRANCH=master
# Only needed when you tick PUSH_IMAGES: GitHub user + token with write:packages
GHCR_USER=none
GHCR_TOKEN=none
