    {
      "name": "3 Documents",
      "item": [
        {
          "name": "Upload a .txt file",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "const doc = pm.response.json();",
                  "pm.test(\"has an id and the text length\", () => {",
                  "  pm.expect(doc.id).to.be.a(\"number\");",
                  "  pm.expect(doc.text_length).to.be.above(50);",
                  "});",
                  "pm.collectionVariables.set(\"docId\", doc.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/documents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "documents"
              ]
            },
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "sample.txt"
                }
              ]
            }
          }
