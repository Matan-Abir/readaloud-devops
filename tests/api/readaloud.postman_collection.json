{
  "info": {
    "name": "ReadAloud API",
    "description": "End-to-end API checks for a deployed ReadAloud (Jenkins stage 7, Verify). Set baseUrl to the app, and host when going through the Ingress by IP.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://readaloud.local"
    },
    {
      "key": "host",
      "value": ""
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "docId",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Jenkins reaches the Ingress by the Minikube node IP, so it sends the",
          "// hostname the Ingress routes on (readaloud.local or staging.readaloud.local).",
          "const host = pm.variables.get(\"host\");",
          "if (host) { pm.request.headers.upsert({ key: \"Host\", value: host }); }"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1 Health",
      "item": [
        {
          "name": "Backend reachable, Piper voice installed",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"natural voice available\", () => pm.expect(pm.response.json().available).to.eql(true));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/tts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tts"
              ]
            },
            "header": [],
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Web app served",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"is the Flutter web app\", () => pm.expect(pm.response.text()).to.include(\"flutter\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                ""
              ]
            },
            "header": [],
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "2 Auth",
      "item": [
        {
          "name": "Register rejects a bad email",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"error is JSON with a message\", () => pm.expect(pm.response.json().error).to.be.a(\"string\").and.not.empty);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"not-an-email\",\n  \"password\": \"long-enough-password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Register",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"email\", `newman-${Date.now()}-${Math.floor(Math.random() * 1e6)}@example.com`);",
                  "pm.collectionVariables.set(\"password\", \"newman-test-password\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"returns the email\", () => pm.expect(pm.response.json().email).to.eql(pm.collectionVariables.get(\"email\")));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
